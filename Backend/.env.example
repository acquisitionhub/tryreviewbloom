# ─────────────────────────────────────────────────
# Review Bloom — Environment Variables
# Copy this to .env.local (never commit .env.local)
# ─────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Anthropic (AI replies + message optimization) ─
ANTHROPIC_API_KEY=sk-ant-your-key

# ── Twilio (SMS sending) ──────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+14155551234

# ── GHL (GoHighLevel) ─────────────────────────────
GHL_API_KEY=your-ghl-api-key
GHL_LOCATION_ID=your-location-id
GHL_WEBHOOK_SECRET=your-webhook-secret   # used to verify GHL webhook calls

# ── Google Business Profile ───────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token  # obtained via OAuth flow
GOOGLE_ACCOUNT_ID=accounts/your-account-id
GOOGLE_LOCATION_ID=locations/your-location-id

# ── Meta (Facebook & Instagram) ──────────────────
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_PAGE_ACCESS_TOKEN=your-page-access-token
META_INSTAGRAM_ACCOUNT_ID=your-ig-account-id
META_FACEBOOK_PAGE_ID=your-fb-page-id

# ── App ───────────────────────────────────────────
NEXTAUTH_SECRET=your-random-secret-string
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
REVIEW_LINK=https://g.page/r/your-google-review-link
